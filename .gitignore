# =============================================================
# ppe-detection
# =============================================================

# Data — never commit. All of this is either downloaded from a public
# source or generated by our own scripts (ingest_external.py,
# build_dataset.py). Regenerate locally instead of committing.
ppe-detection/data/external/
ppe-detection/data/normalized/
ppe-detection/data/merged/
ppe-detection/data/raw/*/images/
ppe-detection/data/raw/*/labels/

# Models — trained weights are large and reproducible from data + config.
ppe-detection/models/trained/
ppe-detection/models/pretrained/
ppe-detection/*.pt
ppe-detection/**/*.pt
ppe-detection/*.onnx
ppe-detection/*.engine

# Ultralytics run artifacts, in case anything writes outside models/
ppe-detection/runs/

# Python env for this subproject (if using a per-project venv)
ppe-detection/.venv/
ppe-detection/kaggle.json
ppe-detection/outputs/*
ppe-detection/data/test_samples/






